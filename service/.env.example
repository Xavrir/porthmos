# ---------------------------------------------------------------------------------------------
# Local Anvil, chain 31337. These are the PUBLIC Anvil test keys (accounts 0, 3, 4, 5, 6).
# They are known to everyone. Never use them on any public network.
# On 31337 the service falls back to these automatically, so they are optional here.
# ---------------------------------------------------------------------------------------------
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# DEPLOYMENTS_PATH=../deployments/31337.json
# CONTRACTS_OUT=../contracts/out
AEGIS_DB=var/aegis.db
INTERNAL_TOKEN=dev-internal-token
DEMO_MODE=1
REQUIRE_SESSION_SIG=0
SIWE_DOMAINS=localhost:*,127.0.0.1:*
ADMIN_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AUTHORIZER_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
EXIT_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
EXECUTOR_KEY=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba
KEEPER_KEY=0x92db14e403b83dfe3df233f83dfa3a0d7096f21ca9b0d6d6b8d88b2b4ec1564e

# Optional OpenAI-compatible LLM. Leave unset for deterministic mode (every feature works without it).
