# AEGIS Treasury service environment for the Tencent CVM (Base Sepolia, chain 84532).
# Copy to aegis.env next to docker-compose.yml, fill the secrets, then: chown root:root aegis.env && chmod 600 aegis.env
# Every value marked SECRET must never be committed, printed or pasted into chat. Testnet keys only.

# ---- Chain -------------------------------------------------------------------------------------------
CHAIN_ID=84532
# Server-side RPC (all five processes). Prefer a keyed provider endpoint; the public one rate-limits.
RPC_URL=https://base-sepolia-rpc.publicnode.com
# RPC the browser uses during onboarding (GET /api/onboard/config rpcUrl). Default for 84532: https://sepolia.base.org
PUBLIC_RPC_URL=https://sepolia.base.org
# Explorer base URL for tx links. Default for 84532: https://sepolia.basescan.org
EXPLORER_URL=https://sepolia.basescan.org
# Inside the image the deployments file is /app/deployments/84532.json (the default for CHAIN_ID=84532).
# DEPLOYMENTS_PATH=/app/deployments/84532.json
# First block of the 84532 deployment; event queries start here (from contracts/broadcast run-latest.json).
DEPLOY_BLOCK=48114516
# Max block range per eth_getLogs call (public RPCs cap it). Default 5000.
# LOG_WINDOW=5000
# ABIs fall back to the hand-written ones in aegis/chain/abi.py when this directory is absent (it is, in the image).
# CONTRACTS_OUT=/app/contracts/out
# rpc (default) or fake (in-memory demo chain, no keys). Keep rpc in production.
# AEGIS_CHAIN=rpc
# Extra reference Safes served next to the deployments-file Safe (CSV). Normally unset.
# AEGIS_EXTRA_SAFES=

# ---- Process keys (SECRET). The supervisor hands each process only its own key. --------------------------
# Authorizer process: signs DARs after independent re-verification.
AUTHORIZER_KEY=
# Exit Agent process: quarantines and signs redeem-only DARs.
EXIT_KEY=
# Executor process: relays signed DARs and pays gas.
EXECUTOR_KEY=
# Keeper process: pokes the mock price feed every 60 s.
KEEPER_KEY=
# API process. DEPLOYER_KEY owns MockUSDC and the mock feed/vaults: faucet ETH drips, the one-time test USDC
# mint per tenant, and admin market scenarios (ADMIN_KEY falls back to DEPLOYER_KEY when unset).
DEPLOYER_KEY=
# ADMIN_KEY=
# API process: broadcasts the per-tenant refused attacks (POST /api/tenant/attack). Needs a little test ETH.
ATTACKER_KEY=

# ---- Service secrets (SECRET) -----------------------------------------------------------------------
# Shared token between the API, Authorizer and Exit Agent internal endpoints. Generate: openssl rand -hex 32
INTERNAL_TOKEN=
# Header X-Aegis-Admin for market scenarios (depeg, liquidity, stale, restore) on 84532. openssl rand -hex 32
ADMIN_TOKEN=
# Salt for hashing client IPs in the onboarding limits (raw IPs are never stored). openssl rand -hex 16
IP_HASH_SALT=

# ---- API ---------------------------------------------------------------------------------------------
# The image sets API_HOST=0.0.0.0 and API_PORT=8787; compose publishes it on 127.0.0.1:8787 only.
# API_HOST=0.0.0.0
# API_PORT=8787
# Internal addresses inside the container (defaults shown).
# AUTHORIZER_URL=http://127.0.0.1:8788
# AUTHORIZER_PORT=8788
# API_INTERNAL_URL=http://127.0.0.1:8787
# Browser origins allowed by CORS (CSV). Default below.
ALLOWED_ORIGINS=https://porthmos.vercel.app,https://aegis-treasury-eta.vercel.app,http://localhost:5173,http://localhost:4173
# Domains a Sign-In with Ethereum message may name (host, host:port, or host:* for any port). Default below.
SIWE_DOMAINS=porthmos.vercel.app,aegis-treasury-eta.vercel.app,localhost:*,127.0.0.1:*
# Every POST /api/session must carry a signed SIWE message. Default 1 off Anvil.
REQUIRE_SESSION_SIG=1
# Local demo scenarios and seeded obligations; must stay 0 on 84532.
DEMO_MODE=0
# Take the client IP from the last X-Forwarded-For entry (set by Caddy). The image sets 1.
TRUST_PROXY=1
# HTTP access log. Off by default off Anvil because the SSE URL carries the session token.
# API_ACCESS_LOG=0
# SQLite file and log directory on the /data volume (set by the image).
# AEGIS_DB=/data/aegis.db
# AUTHORIZER_DB=/data/aegis-authorizer.db
# AEGIS_LOG_DIR=/data/log
# All workers inside the API process instead of five processes. Keep 0 in production.
# AEGIS_IN_PROCESS_WORKERS=0
# A9 demo only: the Executor ignores Exit Agent DARs so the self-submit fallback shows. Keep 0.
# EXECUTOR_WITHHOLD_EXITS=0

# ---- LLM (optional; deterministic mode when LLM_BASE_URL or LLM_MODEL is unset) ----------------------
# CLIProxyAPI on the compose network.
LLM_BASE_URL=http://cliproxy:8317/v1
LLM_MODEL=claude-haiku-5-5
# SECRET. Must equal one of access.api-keys in cliproxy/config.yaml.
LLM_API_KEY=
# Per-call timeout in seconds; a timeout or error makes that request deterministic with a one-line notice.
LLM_TIMEOUT=20

# ---- Multi-tenant onboarding ------------------------------------------------------------------------
# Set 0 to stop accepting new treasuries (existing tenants keep working).
ONBOARDING_OPEN=1
# Seconds between tenant table reloads in each process (spec: new tenants live within 10 s).
# TENANT_REFRESH_SECONDS=3
# Values served as onboarding params (raw units; USDC has 6 decimals, band in 8-decimal price units).
# TENANT_AUTO_CAP=1000000000
# TENANT_DAILY_CAP=5000000000
# TENANT_BANK_LIMIT=3000000000
# TENANT_MAX_BAND_WIDTH=2000000
# TENANT_MAX_ORACLE_AGE=180
# Upper bounds checked at activation (every cap must be > 0 and <= its bound).
# TENANT_AUTO_CAP_MAX=10000000000
# TENANT_DAILY_CAP_MAX=50000000000
# TENANT_BANK_LIMIT_MAX=50000000000
# TENANT_MAX_BAND_WIDTH_MAX=5000000
# TENANT_MAX_ORACLE_AGE_MAX=3600
# Faucet targets in wei (top-up happens when the balance is below half) and the one-time test USDC mint.
# FAUCET_ETH_OWNER=50000000000000
# FAUCET_ETH_BANK=20000000000000
# TEST_USDC_MINT=100000000000

# ---- Abuse limits -----------------------------------------------------------------------------------
# LIMIT_ONBOARD_PER_IP_DAY=3
# LIMIT_MAX_TENANTS=300
# 0.003 ETH per UTC day
# LIMIT_FAUCET_WEI_PER_DAY=3000000000000000
# LIMIT_CHAT_PER_TENANT=20
# LIMIT_CHAT_WINDOW=600
# LIMIT_LLM_PER_HOUR=300
# LIMIT_LLM_PER_TENANT_HOUR=60
# LIMIT_ATTACKS_PER_TENANT_HOUR=6

# ---- Planner metadata (optional) ----------------------------------------------------------------------
# VAULT_A_APY=0.045
# VAULT_B_APY=0.060
# VAULT_A_COST=0.001
# VAULT_B_COST=0.001

# sepolia.base.org caps eth_getLogs at 200 blocks; publicnode accepts ~50k.
LOG_WINDOW=45000
